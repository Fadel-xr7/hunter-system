# هذا لبوت خاص تشغّله من جهازك بس (uv run bot.py).
# البوت الأساسي للكل صار على Supabase: supabase/functions/telegram-bot (توكنه في Secrets هناك، مو هنا).
#
# انسخ هذا الملف باسم .env (بدون example) وعبّي القيم.
# ملف .env ما ينرفع على GitHub (مستثنى في .gitignore).

# التوكن من @BotFather
TELEGRAM_BOT_TOKEN=

# رابط موقعك على GitHub Pages
SITE_URL=https://fadel-xr7.github.io/hunter-system/index.html
# أو على جهازك (Go Live):
# SITE_URL=http://127.0.0.1:5500/docs/index.html

# رقمك في تيليجرام (البوت يعطيك إياه لما ترسل /start).
# لازم تحطه: البوت ما يستقبل مهام من أي أحد قبل ما تضبطه.
ALLOWED_USER_ID=
